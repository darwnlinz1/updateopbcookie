<Page x:Class="OpenBulletCE.Views.StackerBlocks.PageBlockBinaryCodec"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenBulletCE.Views.StackerBlocks"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="400"
      Title="PageBlockBinaryCodec">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="5">
            <!-- Mode and Format -->
            <Grid Margin="0 0 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0 0 5 0">
                    <Label Content="Mode:"/>
                    <ComboBox x:Name="modeCombobox" SelectionChanged="modeCombobox_SelectionChanged"/>
                </DockPanel>

                <DockPanel Grid.Column="1" Margin="5 0 0 0">
                    <Label Content="Format:"/>
                    <ComboBox x:Name="formatCombobox" SelectionChanged="formatCombobox_SelectionChanged"/>
                </DockPanel>
            </Grid>

            <!-- Input String -->
            <DockPanel Margin="0 5 0 0">
                <Label Content="Input String:"/>
                <TextBox Text="{Binding InputString, UpdateSourceTrigger=PropertyChanged}" ToolTip="For Decode: Base64 string or raw bytes (e.g. &lt;SOURCE&gt;). For Encode: JSON string."/>
            </DockPanel>

            <!-- Variable Name -->
            <DockPanel Margin="0 5 0 0">
                <Label Content="Output Variable:"/>
                <ComboBox x:Name="varTypeCombobox" Width="60" Margin="0 0 5 0" SelectionChanged="varTypeCombobox_SelectionChanged">
                    <ComboBoxItem Content="VAR" />
                    <ComboBoxItem Content="CAP" />
                </ComboBox>
                <TextBox Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>

            <!-- Options -->
            <DockPanel Margin="0 5 0 0">
                <CheckBox Content="Create Empty" IsChecked="{Binding CreateEmpty}" VerticalContentAlignment="Center" ToolTip="Create an empty variable if decode/encode produces empty or fails"/>
            </DockPanel>

            <!-- Info block -->
            <Border Margin="0 10 0 0" Padding="8" Background="#222" BorderBrush="#444" BorderThickness="1" CornerRadius="4">
                <TextBlock x:Name="infoTextBlock" TextWrapping="Wrap" Foreground="Gainsboro" FontSize="11"
                           Text="BINARY CODEC converts between raw binary protocols (CBOR, MessagePack, Protobuf Wire) and clean JSON/Base64 strings without schema dependencies."/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
